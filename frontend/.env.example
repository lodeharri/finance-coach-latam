# Finance Coach LATAM — Frontend local environment template.
# Copy this file to `.env.local` and fill in real values.
# Vite reads `.env.local` automatically at `npm run dev` / `npm run build`.

# REQUIRED. Base URL of the deployed backend API (API Gateway v2 endpoint).
# For local dev: point to a running backend or to a staging deployment.
# Format: https://<api-id>.execute-api.<region>.amazonaws.com (no trailing slash).
VITE_API_BASE_URL=

# OPTIONAL. Cognito User Pool Client ID for the SPA's USER_PASSWORD_AUTH flow.
# Defaults to "test-client-id" at runtime if unset — only set this when wiring
# real auth. Read by `frontend/src/services/auth.ts`.
VITE_COGNITO_USER_POOL_CLIENT_ID=

# OPTIONAL. AWS region for the Cognito User Pool.
# Defaults to "us-east-1" at runtime if unset.
VITE_COGNITO_REGION=
