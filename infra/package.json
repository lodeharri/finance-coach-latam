{
  "name": "finance-coach-latam-infra",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud infrastructure for Finance Coach LATAM. AWS CDK v2 stack provisioning Lambda + API Gateway HTTP API v2.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "synth": "cdk synth",
    "deploy": "cdk deploy",
    "diff": "cdk diff",
    "destroy": "cdk destroy",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "aws-cdk": "^2.150.0",
    "esbuild": "^0.24.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.150.0",
    "constructs": "^10.3.0"
  }
}
