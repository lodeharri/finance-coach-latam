# ==============================================
# Finance Coach LATAM — CDK/Infra environment
# Copy this to .env and fill in your values
# ==============================================

# AWS account and region for CDK bootstrap + deploy
CDK_DEFAULT_ACCOUNT=123456789012
CDK_DEFAULT_REGION=us-east-1

# These get passed to Lambda as runtime environment variables
# Must match backend/.env values
DATABASE_URL=
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
