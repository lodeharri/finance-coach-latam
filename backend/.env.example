# ==============================================
# Finance Coach LATAM — Backend environment
# Copy this to .env and fill in your values
# ==============================================

# Database (Neon Postgres HTTP connection string)
# Get from https://neon.tech → your project → Connection string
DATABASE_URL=

# LLM Provider (swappable architecture — see infrastructure/llm/)
# Supported values: gemini | openai
LLM_PROVIDER=gemini

# Gemini API key (https://aistudio.google.com/apikey)
# Required when LLM_PROVIDER=gemini
GEMINI_API_KEY=

# OpenAI API key (https://platform.openai.com/api-keys)
# Required when LLM_PROVIDER=openai (future use)
OPENAI_API_KEY=

# AWS / Runtime
AWS_REGION=us-east-1
NODE_ENV=development
